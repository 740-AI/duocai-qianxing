# Hugging Face Spaces 专用镜像
# 容器以非 root 用户运行（HF 要求 UID 1000），监听 7860 端口
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=7860 \
    QX_DB=/home/user/app/data/app.db

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

RUN useradd -m -u 1000 user && chown -R user:user /app
USER user
ENV HOME=/home/user

EXPOSE 7860

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s \
  CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:7860/api/health',timeout=3).status==200 else 1)"

CMD ["gunicorn", "-c", "gunicorn.conf.py", "wsgi:application"]
